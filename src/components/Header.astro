---
const base = import.meta.env.BASE_URL || "/";
const home = base.endsWith("/") ? base : `${base}/`;
---
<header class="header">
<a class="brand" href={home} aria-label="Vertical 4 Construction home">
<img class="brand-logo" src={`${home}assets/images/vertical4-logo.PNG`} alt="" onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
<span class="brand-fallback" hidden>VERTICAL 4</span>
</a>
<div class="header-center"><span>ARCHITECTURE</span><span>INTERIORS</span><span>DELIVERY</span></div>
<button class="nav-button" type="button" data-menu-open aria-label="Open menu"><span>MENU</span><span class="nav-lines" aria-hidden="true"><i></i><i></i></span></button>
</header>
