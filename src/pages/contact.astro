---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site.js";
---
<BaseLayout title="Contact — Vertical 4 Construction" description="Contact Vertical 4 Construction in Bengaluru." bodyClass="page-placeholder">
  <section class="route-placeholder">
    <div class="page-shell">
      <div class="page-kicker"><span>07 — CONTACT</span><span>VERTICAL 4 CONSTRUCTION</span></div>
      <div class="route-placeholder__content">
        <h1>CONTACT</h1>
        <p>Discuss your construction, structural strengthening or sustainable architecture project with Vertical 4 Construction.</p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p><a href="tel:+919620911849">{SITE.phone}</a></p>
        <p>{SITE.location}</p>
      </div>
    </div>
  </section>
</BaseLayout>
