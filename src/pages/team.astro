---
import BaseLayout from "../layouts/BaseLayout.astro";
const founderExperience = [
  "Anand Amaresh — Khosla and Anand Associates",
  "Dominic Dube — DDIR Architecture",
  "Ashwin — Ashwin Architects",
  "Prakash Selvaraj — Genesis Architecture",
  "Rakesh Kodath — Dialogue Design Partners",
  "Gunjan Bajaj — Gutika House of Design",
  "Vivek Kotharia — D-OR Studio",
];
const collaborations = [
  "Nischith Kashyap & Pooja Rao — Studio NKPR",
  "Manjunath — Studio Whitescape",
  "Varun Thautham & Namratha Toraskar — Vanamu",
  "Veerajshet — Veerajshet Design Studio",
  "Meinathan & Sai Harini — Architecture + Swath",
  "Vivek & Naveen — Studio Envisage",
  "Akshay — Tattvakala Architects",
  "Brijila Kishore — Loam Architects",
  "Jeyashri — Mitti Lab",
  "Kapok Architects",
];
---
<BaseLayout title="Team — Vertical 4 Construction" description="Founder experience and architectural collaborations of Vertical 4 Construction." bodyClass="page-placeholder page-team">
  <section class="route-placeholder">
    <div class="page-shell">
      <div class="page-kicker"><span>06 — PEOPLE & COLLABORATIONS</span><span>VERTICAL 4 CONSTRUCTION</span></div>
      <div class="route-placeholder__content">
        <h1>HEMANTH KUMAR R</h1>
        <p>Founder, Vertical 4 Construction. A civil engineer with project engineering experience executing work designed by leading architectural practices.</p>
        <h2>FOUNDER'S PROJECT ENGINEERING EXPERIENCE</h2>
        <ul class="team-list">{founderExperience.map((person) => <li>{person}</li>)}</ul>
        <h2>ARCHITECTURAL COLLABORATIONS AS CONTRACTOR</h2>
        <ul class="team-list">{collaborations.map((person) => <li>{person}</li>)}</ul>
        <h2>OUR TEAM</h2>
        <p>Additional team profiles will be added when provided.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-team .route-placeholder{padding:clamp(42px,6vw,96px) var(--page-pad) clamp(75px,9vw,145px);background:#fff}
  .page-team .page-shell{max-width:1440px;margin:0 auto}
  .page-team .page-kicker{display:flex;justify-content:space-between;gap:24px;padding-bottom:20px;border-bottom:1px solid #d0d0d2;color:#777;font-size:10px;letter-spacing:.12em}
  .page-team .route-placeholder__content{max-width:1050px;padding-top:clamp(45px,7vw,110px)}
  .page-team h1{font-size:clamp(46px,8vw,116px);line-height:.98;font-weight:300;letter-spacing:-.065em;overflow-wrap:break-word;margin:0 0 32px}
  .page-team .route-placeholder__content>p{max-width:760px;font-size:clamp(15px,1.55vw,20px);line-height:1.65;color:#343436;margin:0 0 55px}
  .page-team h2{font-size:clamp(19px,2.6vw,32px);line-height:1.2;font-weight:400;letter-spacing:-.035em;margin:58px 0 22px}
  .page-team .team-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 38px;padding:0;border-top:1px solid #d0d0d2}
  .page-team .team-list li{padding:18px 0;border-bottom:1px solid #d0d0d2;font-size:clamp(13px,1.2vw,17px);line-height:1.5;overflow-wrap:anywhere}
  @media(max-width:767px){.page-team .page-kicker{font-size:8px}.page-team .page-kicker span:last-child{display:none}.page-team .team-list{grid-template-columns:1fr}.page-team h1{font-size:clamp(43px,11vw,74px)}}
</style>
