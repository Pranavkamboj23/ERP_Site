---
import BaseLayout from "../layouts/BaseLayout.astro";

const founderExperience = [
  ["Anand Amaresh", "Khosla and Anand Associates"],
  ["Dominic Dube", "DDIR Architecture"],
  ["Ashwin", "Ashwin Architects"],
  ["Prakash Selvaraj", "Genesis Architecture"],
  ["Rakesh Kodath", "Dialogue Design Partners"],
  ["Gunjan Bajaj", "Gutika House of Design"],
  ["Vivek Kotharia", "D-OR Studio"],
];

const collaborations = [
  ["Nischith Kashyap & Pooja Rao", "Studio NKPR"],
  ["Manjunath", "Studio Whitescape"],
  ["Varun Thautham & Namratha Toraskar", "Vanamu"],
  ["Veerajshet", "Veerajshet Design Studio"],
  ["Meinathan & Sai Harini", "Architecture + Swath"],
  ["Vivek & Naveen", "Studio Envisage"],
  ["Akshay", "Tattvakala Architects"],
  ["Brijila Kishore", "Loam Architects"],
  ["Jeyashri", "Mitti Lab"],
  ["Kapok Architects", ""],
];
---

<BaseLayout
  title="Team — Vertical 4 Construction"
  description="Meet the founder and architectural collaborators of Vertical 4 Construction."
  bodyClass="page-team"
>
  <section class="team-page" aria-labelledby="team-heading">
    <div class="team-page__shell">
      <div class="team-page__eyebrow">
        <span>06 — PEOPLE & COLLABORATIONS</span>
        <span>VERTICAL 4 CONSTRUCTION</span>
      </div>

      <header class="team-page__intro">
        <p class="team-page__label">FOUNDER / VERTICAL 4 CONSTRUCTION</p>
        <h1 id="team-heading">HEMANTH<br />KUMAR R</h1>
        <p class="team-page__description">
          Hemanth Kumar R, founder of Vertical 4 Construction, is a civil engineer
          with project engineering experience executing projects designed by
          leading architectural practices.
        </p>
      </header>

      <section class="team-page__section" aria-labelledby="experience-heading">
        <div class="team-page__section-heading">
          <span class="team-page__number">01 / EXPERIENCE</span>
          <h2 id="experience-heading">Founder's project engineering experience</h2>
        </div>
        <ul class="team-page__list">
          {founderExperience.map(([person, studio]) => (
            <li><span class="team-page__person">{person}</span><span class="team-page__studio">{studio}</span></li>
          ))}
        </ul>
      </section>

      <section class="team-page__section" aria-labelledby="collaborations-heading">
        <div class="team-page__section-heading">
          <span class="team-page__number">02 / COLLABORATIONS</span>
          <h2 id="collaborations-heading">Architectural collaborations as contractor</h2>
        </div>
        <ul class="team-page__list">
          {collaborations.map(([person, studio]) => (
            <li><span class="team-page__person">{person}</span>{studio && <span class="team-page__studio">{studio}</span>}</li>
          ))}
        </ul>
      </section>

      <section class="team-page__section team-page__section--last" aria-labelledby="team-profiles-heading">
        <div class="team-page__section-heading">
          <span class="team-page__number">03 / TEAM</span>
          <h2 id="team-profiles-heading">Our team</h2>
        </div>
        <p class="team-page__description">Additional team profiles will be added when provided.</p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .team-page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: calc(var(--header-height, 70px) + clamp(36px, 5vw, 78px)) var(--page-pad, 30px) clamp(80px, 10vw, 150px);
    background: #fff;
    color: #0f1012;
  }
  .team-page *, .team-page *::before, .team-page *::after { box-sizing: border-box; }
  .team-page__shell { max-width: 1440px; margin: 0 auto; }
  .team-page__eyebrow { display: flex; justify-content: space-between; gap: 24px; padding-bottom: 20px; border-bottom: 1px solid #d0d0d2; color: #777; font-size: 10px; font-weight: 500; letter-spacing: .13em; line-height: 1.5; }
  .team-page__intro { padding: clamp(58px, 9vw, 130px) 0 clamp(72px, 10vw, 150px); }
  .team-page__label, .team-page__number { display: block; margin: 0; color: #777; font-size: 10px; font-weight: 500; letter-spacing: .13em; line-height: 1.5; text-transform: uppercase; }
  .team-page h1 { max-width: 100%; margin: 22px 0 34px; font-size: clamp(52px, 10vw, 148px); font-weight: 300; line-height: .98; letter-spacing: -.065em; overflow-wrap: normal; }
  .team-page__description { max-width: 790px; margin: 0; color: #343436; font-size: clamp(16px, 1.55vw, 21px); line-height: 1.65; }
  .team-page__section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); column-gap: clamp(36px, 6vw, 110px); padding: clamp(50px, 7vw, 100px) 0; border-top: 1px solid #d0d0d2; }
  .team-page__section--last { padding-bottom: 0; }
  .team-page__section-heading { min-width: 0; }
  .team-page h2 { max-width: 570px; margin: 22px 0 0; font-size: clamp(28px, 3.2vw, 48px); font-weight: 400; letter-spacing: -.045em; line-height: 1.12; overflow-wrap: normal; }
  .team-page__list { display: block; min-width: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid #d0d0d2; }
  .team-page__list li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px 22px; align-items: start; padding: 19px 0; border-bottom: 1px solid #d0d0d2; font-size: clamp(14px, 1.15vw, 17px); line-height: 1.5; overflow-wrap: break-word; }
  .team-page__person { font-weight: 500; }
  .team-page__studio { color: #68686a; }
  @media (max-width: 900px) {
    .team-page__section { grid-template-columns: 1fr; gap: 32px; }
    .team-page__intro { padding: 70px 0 90px; }
  }
  @media (max-width: 600px) {
    .team-page { padding-top: calc(var(--header-height, 62px) + 32px); }
    .team-page__eyebrow span:last-child { display: none; }
    .team-page h1 { font-size: clamp(43px, 11vw, 72px); letter-spacing: -.055em; }
    .team-page h2 { font-size: clamp(27px, 7vw, 38px); }
    .team-page__list li { grid-template-columns: 1fr; gap: 3px; }
    .team-page__section { padding: 54px 0; }
  }
</style>
